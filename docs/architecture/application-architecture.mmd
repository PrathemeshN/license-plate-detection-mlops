flowchart LR
    USER["Client Device / Browser<br/>HTML · CSS · JavaScript<br/>Single image · Bulk ZIP · getUserMedia camera"]

    subgraph APP["PLATEVISION APPLICATION"]
      direction TB

      subgraph ACCESS["ACCESS / AWS RUNTIME"]
        direction LR
        CF["Amazon CloudFront<br/>Shown as implemented in supplied architecture reference<br/>Live route not verified from repository"]
        TEST["Documented test ingress<br/>ECS task public IP :8000<br/>Restricted to tester IPv4 /32"]
        ECS["Amazon ECS Fargate<br/>license-plate-api service<br/>Container port 8000"]
      end

      subgraph CONTAINER["DOCKER CONTAINER · Python 3.13 · Uvicorn / FastAPI · non-root appuser"]
        direction LR
        MAIN["app/main.py<br/>Serves frontend / and /static<br/>CORS + RequestSizeLimitMiddleware<br/>Configures stdout logging"]
        ROUTES["app/api/routes.py<br/>POST /api/v1/predict<br/>POST /api/v1/bulk-predict<br/>GET /health · /ready · /openapi.json"]
        VALID["Request validation<br/>Image MIME / suffix validation<br/>10 MB per image · 25 MB ZIP<br/>≤100 ZIP entries · ≤200 MB expanded<br/>Path traversal and symlink checks"]
        SERVICE["app/services/inference_service.py<br/>Calls inference engine<br/>Maps detections to Pydantic response DTOs"]
        ENGINE["app/inference/engine.py<br/>Ultralytics YOLO prediction<br/>Confidence threshold 0.38<br/>NMS IoU threshold 0.50"]
        MODEL["YOLO11n V3 model<br/>models/yolo11n-v3/best.pt<br/>Class: license_plate"]
        SCHEMA["app/schemas/inference.py<br/>PredictionResponse / BulkPredictionResponse<br/>DetectionResponse / BoundingBoxResponse<br/>Validates response structures"]
        MAIN --> ROUTES --> VALID --> SERVICE --> ENGINE --> MODEL
        ENGINE --> SCHEMA
      end

      subgraph DATA["RESULTS AND DATA HANDLING"]
        direction RL
        JSON["API response JSON<br/>count · detections[] / results[]<br/>bbox · class_id/name · confidence<br/>review_required"]
        UI["Browser UI<br/>Bounding-box overlays<br/>Bulk per-file rows<br/>Camera-frame overlays"]
        CSV["CSV export<br/>Generated by frontend from response data"]
        TEMP["Temporary file handling<br/>Uploads / extracted image members<br/>Removed after prediction"]
        NODB["Application database<br/>None found in repository implementation<br/>No SQL/NoSQL connector or ORM layer<br/>No persistent result lookup / save path<br/>No database location applies"]
        SCHEMA --> JSON --> UI --> CSV
        VALID -. "temporary staging" .-> TEMP
        JSON -. "not persisted to database" .- NODB
      end

      subgraph SUPPORT["CLOUD AND RELEASE SUPPORT"]
        direction LR
        CW["Amazon CloudWatch Logs<br/>Python logging to stdout<br/>/ecs/license-plate-detector"]
        ECR["Amazon ECR<br/>Private container-image repository"]
        ECSR["Amazon ECS / Fargate<br/>Runs selected task definition / image"]
      end
    end

    USER --> TEST
    TEST --> ECS
    CF -. "CloudFront origin path if configured" .-> ECS
    ECS --> MAIN
    UI --> USER
    MAIN -. "stdout / stderr" .-> CW
    ECR -. "container image artifact" .-> ECSR
    ECSR -. "runs task" .-> ECS

    subgraph CICD["GITHUB ACTIONS CI / CD"]
      direction LR
      SOURCE["Push / pull request"]
      QUALITY["Quality and tests<br/>Ruff · Black · Mypy<br/>pytest + coverage threshold<br/>Node frontend tests"]
      SECURITY["Security checks<br/>Bandit · pip-audit"]
      DOCKER["Docker build and smoke tests<br/>health · readiness · OpenAPI<br/>single and bulk inference"]
      OIDC["GitHub OIDC<br/>Short-lived AWS credentials"]
      PUSH["Build commit-SHA image<br/>Push image to ECR"]
      DEPLOY["Register task definition<br/>Update ECS service<br/>Verify health + image digest<br/>Rollback on failed verification"]
      SOURCE --> QUALITY --> SECURITY --> DOCKER --> OIDC --> PUSH --> DEPLOY
    end

